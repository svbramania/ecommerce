# Copy to .env, fill in real values, never commit the filled-in version
# (already in .gitignore). This documents every credential the app
# needs — nothing here is a real secret.

# --- Storefront (storefront/.env.local) ---
# Points at the introspection-gating proxy (docker-compose's
# graphql-introspection-guard), not Saleor's own port directly — see
# backend/apps/graphql_introspection_guard/proxy.py and the
# api-introspection entry in docs/security-checklist.md.
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8100/graphql/
# Backs rate limiting on login/register/coupon-apply/checkout-payment
# (storefront/src/lib/rate-limit.ts) — the same Redis instance
# docker-compose already runs as `cache`. Defaults to that if unset.
REDIS_URL=redis://127.0.0.1:6379

# --- Stripe (Phase 1 — wired in, see backend/apps/payment_webhook_receiver/) ---
# Test/sandbox keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen` locally, or a real webhook endpoint's signing
# secret once deployed — not consumed by receiver.py yet (HMAC
# verification uses PAYMENT_WEBHOOK_SECRET in backend/payment.env
# instead), kept here for when Stripe's own async events are added.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- TaxJar (Phase 3 — wired in, see backend/apps/tax_webhook_receiver/) ---
# Sandbox token from https://app.taxjar.com/api_sign_up
TAXJAR_API_TOKEN=

# --- PayPal (Phase 3 — wired in, see backend/apps/payment_webhook_receiver/) ---
# Sandbox app credentials from https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- EasyPost (Phase 3 — wired in, see backend/apps/shipping_webhook_receiver/) ---
# Test key from https://www.easypost.com
EASYPOST_API_KEY=

# --- Object storage (S3-compatible, for staging/prod media — not wired to
# local dev yet; see the "Known gaps" note in docs/phase-0-foundation.md) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_MEDIA_BUCKET_NAME=

# --- Real business facts still needed (see each app's README for why) ---
# Ship-from address for tax nexus — backend/tax.env's TAX_ORIGIN_*
# Ship-from address for shipping rates — backend/shipping.env's SHIP_FROM_*
# Both genuinely unset until this business has a real address to give them.
