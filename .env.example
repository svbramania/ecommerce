# Copy to .env, fill in real values, never commit the filled-in version
# (already in .gitignore). This documents every credential Phase 0+ needs —
# nothing here is a real secret.

# --- Storefront (storefront/.env.local) ---
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/

# --- Stripe (Phase 0/1 — sandbox/test mode only for now) ---
# Get test keys from https://dashboard.stripe.com/test/apikeys — real keys,
# not fabricated here. Wiring these into Saleor's Stripe payment app is
# tracked in docs/phase-0-foundation.md; not done yet.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Object storage (S3-compatible, for staging/prod media — not wired to
# local dev yet; see the "Known gaps" note in docs/phase-0-foundation.md) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_MEDIA_BUCKET_NAME=

# --- Phase 3 test connections — none of these are wired into code yet.
# Fill in whichever ones you've signed up for; each becomes real the
# moment its integration is built (same pattern as Stripe above). ---

# TaxJar (tax) — free-trial API token from https://app.taxjar.com/api_sign_up
TAXJAR_API_TOKEN=

# PayPal Developer sandbox (BNPL, Pay in 4) — from https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# EasyPost (shipping rates) — from https://www.easypost.com — use this OR Shippo, not both
EASYPOST_API_KEY=

# Shippo (shipping rates, alternative to EasyPost) — from https://goshippo.com
SHIPPO_API_TOKEN=

# Stripe Radar (fraud) needs no separate key — it's active the moment the
# Stripe keys above are real.
