# Shared between api, worker, and scheduler containers.
# Real values (from Saleor's own documented 12-factor config), not placeholders —
# these are safe non-secret defaults for local dev only. See ../.env.example
# for the secrets that must NOT be committed (copy that to .env and fill it in).

DEFAULT_CHANNEL_SLUG=default-channel
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD

# Local-dev only: allows the storefront (running outside the compose network,
# e.g. localhost:3000) to reach the API without HTTPS. Tighten before staging/prod.
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True
# Saleor's own SSRF protection (blocks webhook targets on private IP ranges)
# rejects the docker-compose internal network address of our own
# fulfillment-webhook receiver — confirmed live via a real
# "Forbidden IP address ... Invalid IP address" delivery failure in the
# worker logs. Disabled for local dev only, where every webhook target is
# our own internal service; a real 3PL's endpoint in staging/prod is a
# public HTTPS URL, not a private IP, so this should stay True there.
# User-approved 2026-09-10 — see docs/phase-2-fulfillment.md.
HTTP_IP_FILTER_ENABLED=False
