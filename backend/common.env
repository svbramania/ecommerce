# Shared between api, worker, and scheduler containers.
# Real values (from Saleor's own documented 12-factor config), not placeholders —
# these are safe non-secret defaults for local dev only. See ../.env.example
# for the secrets that must NOT be committed (copy that to .env and fill it in).

DEFAULT_CHANNEL_SLUG=default-channel
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD

# Local-dev only: allows the storefront (running outside the compose network,
# e.g. localhost:3000) to reach the API without HTTPS. Tighten before staging/prod.
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True
HTTP_IP_FILTER_ENABLED=True
