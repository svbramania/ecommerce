# api + worker containers. Local-dev defaults only — SECRET_KEY below is the
# same placeholder Saleor's own reference docker-compose ships (not a real
# secret); replace it via a real .env/secrets manager for anything beyond a
# laptop. Nothing in this file should ever hold a production credential.

DATABASE_URL=postgres://saleor:saleor@db/saleor
CACHE_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1
SECRET_KEY=changeme
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_URL=smtp://mailpit:1025
