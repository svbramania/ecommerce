# Copy to backend/tax.env (gitignored).
TAX_WEBHOOK_SECRET=
# Real ship-from address for this business — genuinely unset until
# supplied. Without it, TaxJar correctly reports no nexus and every
# order shows $0 tax (see backend/apps/tax_webhook_receiver/README.md).
TAX_ORIGIN_COUNTRY=
TAX_ORIGIN_STATE=
TAX_ORIGIN_ZIP=
TAX_ORIGIN_CITY=
TAX_ORIGIN_STREET=
